@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix epp:  <http://lv2plug.in/ns/ext/port-props#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix plug: <http://srmourasilva.github.io/plugins/tetr4-switch#> .

plug:preset_label_1
    a lv2:Parameter ;
    rdfs:label "Preset label 1" ;
    rdfs:comment "Custom name shown for preset 1, instead of the default 'Prst 1'." ;
    rdfs:range atom:String .

plug:preset_label_2
    a lv2:Parameter ;
    rdfs:label "Preset label 2" ;
    rdfs:comment "Custom name shown for preset 2, instead of the default 'Prst 2'." ;
    rdfs:range atom:String .

plug:preset_label_3
    a lv2:Parameter ;
    rdfs:label "Preset label 3" ;
    rdfs:comment "Custom name shown for preset 3, instead of the default 'Prst 3'." ;
    rdfs:range atom:String .

plug:preset_label_4
    a lv2:Parameter ;
    rdfs:label "Preset label 4" ;
    rdfs:comment "Custom name shown for preset 4, instead of the default 'Prst 4'." ;
    rdfs:range atom:String .

plug:group_cv_outputs
    a pg:Group ;
    lv2:symbol "cv_outputs" ;
    lv2:name "CV outputs" .

plug:group_preset_selection
    a pg:Group ;
    lv2:symbol "preset_selection" ;
    lv2:name "Preset selection" .

plug:group_notifications
    a pg:Group ;
    lv2:symbol "notifications" ;
    lv2:name "Notifications" .

plug:group_preset_1
    a pg:Group ;
    lv2:symbol "preset_1" ;
    lv2:name "Preset 1 - Dip switches" .

plug:group_preset_2
    a pg:Group ;
    lv2:symbol "preset_2" ;
    lv2:name "Preset 2 - Dip switches" .

plug:group_preset_3
    a pg:Group ;
    lv2:symbol "preset_3" ;
    lv2:name "Preset 3 - Dip switches" .

plug:group_preset_4
    a pg:Group ;
    lv2:symbol "preset_4" ;
    lv2:name "Preset 4 - Dip switches" .

<http://srmourasilva.github.io/plugins/tetr4-switch>
    a lv2:Plugin, mod:ControlVoltagePlugin, mod:UtilityPlugin ;

doap:name "Tetr4 switch" ;
doap:license <http://opensource.org/licenses/Apache-2.0> ;
doap:developer [
    foaf:name "Paulo Mateus" ;
    foaf:homepage <> ;
    foaf:mbox <mailto:mateus.moura@hotmail.com> ;
    ];

doap:maintainer [
    foaf:name "SrMouraSilva" ;
    foaf:homepage <https://github.com/SrMouraSilva/plugins-lv2> ;
    foaf:mbox <mailto:mateus.moura@hotmail.com> ;
    ];

    lv2:requiredFeature urid:map;
    lv2:optionalFeature lv2:hardRTCapable, state:loadDefaultState, <http://moddevices.com/ns/hmi#WidgetControl>;
    lv2:extensionData <http://moddevices.com/ns/hmi#PluginNotification>, state:interface;

    lv2:majorVersion 1 ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;

rdfs:comment """
Tetr4 switch is a loop switcher for CV. Store which of its four CV outputs are on in each of four presets, and change between them with a single footswitch.
""" ;


# Outputs
lv2:port
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 0;
    lv2:symbol "Cv_output_1";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 1";
    rdfs:comment "CV output 1. Its value is set by output 1 of the currently active preset's dip switches." ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 1;
    lv2:symbol "Cv_output_2";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 2";
    rdfs:comment "CV output 2. Its value is set by output 2 of the currently active preset's dip switches." ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 2;
    lv2:symbol "Cv_output_3";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 3";
    rdfs:comment "CV output 3. Its value is set by output 3 of the currently active preset's dip switches." ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 3;
    lv2:symbol "Cv_output_4";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 4";
    rdfs:comment "CV output 4. Its value is set by output 4 of the currently active preset's dip switches." ;
],
# Preset selectors (footswitch selectors)
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 4;
    lv2:symbol "Preset_selector_1" ;
    pg:group plug:group_preset_selection ;
    lv2:name "Preset 1" ;
    lv2:default 1.0 ;
    #lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    #lv2:portProperty lv2:toggled, epp:trigger;
    #lv2:portProperty lv2:toggled;
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    rdfs:comment "Selects preset 1 as the active preset. Assign a footswitch to it to switch presets. Turning it on turns the other Preset selectors off." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 5;
    lv2:symbol "Preset_selector_2" ;
    pg:group plug:group_preset_selection ;
    lv2:name "Preset 2" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    #lv2:portProperty lv2:toggled, epp:trigger;
    #lv2:portProperty lv2:toggled;
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    rdfs:comment "Selects preset 2 as the active preset. Assign a footswitch to it to switch presets. Turning it on turns the other Preset selectors off." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 6;
    lv2:symbol "Preset_selector_3" ;
    pg:group plug:group_preset_selection ;
    lv2:name "Preset 3" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    #lv2:portProperty lv2:toggled, epp:trigger;
    #lv2:portProperty lv2:toggled;
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    rdfs:comment "Selects preset 3 as the active preset. Assign a footswitch to it to switch presets. Turning it on turns the other Preset selectors off." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 7;
    lv2:symbol "Preset_selector_4" ;
    pg:group plug:group_preset_selection ;
    lv2:name "Preset 4" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    #lv2:portProperty lv2:toggled, epp:trigger;
    #lv2:portProperty lv2:toggled;
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    rdfs:comment "Selects preset 4 as the active preset. Assign a footswitch to it to switch presets. Turning it on turns the other Preset selectors off." ;
],
# Based on
# https://github.com/moddevices/mod-utilities/blob/b8a9d4558efc136c4ce90657a5958064640074f1/SwitchBox_2-1/switchbox_2-1.lv2/switchbox_2-1.ttl
[
    a lv2:ControlPort, lv2:InputPort;
    lv2:index 8;
    lv2:symbol "Preset_combobox";
    pg:group plug:group_preset_selection ;
    lv2:name "Current preset";
    lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [rdfs:label "Prst 1"; rdf:value 0];
        lv2:scalePoint [rdfs:label "Prst 2"; rdf:value 1];
        lv2:scalePoint [rdfs:label "Prst 3"; rdf:value 2];
        lv2:scalePoint [rdfs:label "Prst 4"; rdf:value 3];
    lv2:default 0;
    lv2:minimum 0;
    lv2:maximum 3;
    rdfs:comment "Shows and selects which preset (1 to 4) is currently active. It is kept in sync with the Preset selector footswitches." ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 9;
    lv2:symbol "Assign_to_notify_1";
    pg:group plug:group_notifications ;
    lv2:name "Assign to notfy1";
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    lv2:default 0;
    lv2:minimum 0;
    lv2:maximum 1;
    rdfs:comment "Not directly controlled by the user. Assign a footswitch page to it so a pop-up with the active preset's label is shown on the device screen whenever the preset changes." ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 10;
    lv2:symbol "Assign_to_notify_2";
    pg:group plug:group_notifications ;
    lv2:name "Assign to notfy2";
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    lv2:default 0;
    lv2:minimum 0;
    lv2:maximum 1;
    rdfs:comment "Not directly controlled by the user. Assign a footswitch page to it so a pop-up with the active preset's label is shown on the device screen whenever the preset changes. Use this to show the notification on a second page." ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 11;
    lv2:symbol "Assign_to_notify_3";
    pg:group plug:group_notifications ;
    lv2:name "Assign to notfy3";
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    lv2:default 0;
    lv2:minimum 0;
    lv2:maximum 1;
    rdfs:comment "Not directly controlled by the user. Assign a footswitch page to it so a pop-up with the active preset's label is shown on the device screen whenever the preset changes. Use this to show the notification on a third page." ;
],
[
    a lv2:InputPort, lv2:ControlPort;
    lv2:index 12;
    lv2:symbol "Assign_to_notify_4";
    pg:group plug:group_notifications ;
    lv2:name "Assign to notfy4";
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    lv2:default 0;
    lv2:minimum 0;
    lv2:maximum 1;
    rdfs:comment "Not directly controlled by the user. Assign a footswitch page to it so a pop-up with the active preset's label is shown on the device screen whenever the preset changes. Use this to show the notification on a fourth page." ;
],
# Preset 1 - Dip Switches
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 13;
    lv2:symbol "Preset_1_output_1" ;
    pg:group plug:group_preset_1 ;
    lv2:name "Preset 1 - Output 1" ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 1 will have when preset 1 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 14;
    lv2:symbol "Preset_1_output_2" ;
    pg:group plug:group_preset_1 ;
    lv2:name "Preset 1 - Output 2" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 2 will have when preset 1 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 15;
    lv2:symbol "Preset_1_output_3" ;
    pg:group plug:group_preset_1 ;
    lv2:name "Preset 1 - Output 3" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 3 will have when preset 1 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 16;
    lv2:symbol "Preset_1_output_4" ;
    pg:group plug:group_preset_1 ;
    lv2:name "Preset 1 - Output 4" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 4 will have when preset 1 is active (on = high, off = low)." ;
],
# Preset 2 - Dip Switches
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 17;
    lv2:symbol "Preset_2_output_1" ;
    pg:group plug:group_preset_2 ;
    lv2:name "Preset 2 - Output 1" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 1 will have when preset 2 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 18;
    lv2:symbol "Preset_2_output_2" ;
    pg:group plug:group_preset_2 ;
    lv2:name "Preset 2 - Output 2" ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 2 will have when preset 2 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 19;
    lv2:symbol "Preset_2_output_3" ;
    pg:group plug:group_preset_2 ;
    lv2:name "Preset 2 - Output 3" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 3 will have when preset 2 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 20;
    lv2:symbol "Preset_2_output_4" ;
    pg:group plug:group_preset_2 ;
    lv2:name "Preset 2 - Output 4" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 4 will have when preset 2 is active (on = high, off = low)." ;
],
# Preset 3 - Dip Switches
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 21;
    lv2:symbol "Preset_3_output_1" ;
    pg:group plug:group_preset_3 ;
    lv2:name "Preset 3 - Output 1" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 1 will have when preset 3 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 22;
    lv2:symbol "Preset_3_output_2" ;
    pg:group plug:group_preset_3 ;
    lv2:name "Preset 3 - Output 2" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 2 will have when preset 3 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 23;
    lv2:symbol "Preset_3_output_3" ;
    pg:group plug:group_preset_3 ;
    lv2:name "Preset 3 - Output 3" ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 3 will have when preset 3 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 24;
    lv2:symbol "Preset_3_output_4" ;
    pg:group plug:group_preset_3 ;
    lv2:name "Preset 3 - Output 4" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 4 will have when preset 3 is active (on = high, off = low)." ;
],
# Preset 4 - Dip Switches
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 25;
    lv2:symbol "Preset_4_output_1" ;
    pg:group plug:group_preset_4 ;
    lv2:name "Preset 4 - Output 1" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 1 will have when preset 4 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 26;
    lv2:symbol "Preset_4_output_2" ;
    pg:group plug:group_preset_4 ;
    lv2:name "Preset 4 - Output 2" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 2 will have when preset 4 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 27;
    lv2:symbol "Preset_4_output_3" ;
    pg:group plug:group_preset_4 ;
    lv2:name "Preset 4 - Output 3" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 3 will have when preset 4 is active (on = high, off = low)." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 28;
    lv2:symbol "Preset_4_output_4" ;
    pg:group plug:group_preset_4 ;
    lv2:name "Preset 4 - Output 4" ;
    lv2:default 1.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:toggled;
    rdfs:comment "Dip switch: value that CV Output 4 will have when preset 4 is active (on = high, off = low)." ;
],

[
    a lv2:InputPort, atom:AtomPort ;
    lv2:index 29 ;
    lv2:symbol "events_in" ;
    lv2:name "Events In" ;
    atom:bufferType atom:Sequence ;
    atom:supports patch:Message ;
    lv2:designation lv2:control ;
    rdfs:comment "Internal port used to receive patch:Set/patch:Get messages, such as reading and writing the preset labels." ;

],
[
    a lv2:OutputPort, atom:AtomPort ;
    lv2:index 30 ;
    lv2:symbol "events_out" ;
    lv2:name "Events Out" ;
    atom:bufferType atom:Sequence ;
    atom:supports patch:Message ;
    rdfs:comment "Internal port used to send patch:Set messages, such as replying with the current preset labels." ;
] ;

patch:writable plug:preset_label_1 ,
               plug:preset_label_2 ,
               plug:preset_label_3 ,
               plug:preset_label_4 ;

state:state [
    plug:preset_label_1 "Preset 1" ;
    plug:preset_label_2 "Preset 2" ;
    plug:preset_label_3 "Preset 3" ;
    plug:preset_label_4 "Preset 4" ;
]

.
