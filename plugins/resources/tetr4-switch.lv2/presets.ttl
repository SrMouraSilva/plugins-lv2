             [ lv2:symbol "Preset_1_output_1" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_1_output_2" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_1_output_3" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_1_output_4" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_2_output_1" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_2_output_2" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_2_output_3" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_2_output_4" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_3_output_1" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_3_output_2" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_3_output_3" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_3_output_4" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_4_output_1" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_4_output_2" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_4_output_3" ; pset:value 1.0 ] ,
