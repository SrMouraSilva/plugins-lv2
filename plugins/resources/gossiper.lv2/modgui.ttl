@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://srmourasilva.github.io/plugins/gossiper>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/gossiper.html> ;
        # Full-screen, touch-friendly settings page, instead of the generic one
        modgui:settingsTemplate <modgui/gossiper-settings.html> ;
        modgui:stylesheet <modgui/gossiper.css> ;
        modgui:javascript <modgui/gossiper.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:documentation <modgui/manual.pdf> ;
        modgui:brand "SrMouraSilva" ;
        modgui:label "Gossiper" ;
        modgui:model "boxy-small" ;
        modgui:panel "1-footswitch" ;
        modgui:color "#1e0431" ;
        modgui:discussionURL <https://forum.mod.audio/t/gossiper-plugin-to-say-what-is-happening-when-you-are-looking-it/9660> ;
    ] .