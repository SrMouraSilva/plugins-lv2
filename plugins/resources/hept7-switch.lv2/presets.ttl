# Factory presets. Each one starts on preset 1 and names the seven presets after the scenes.

# Exactly one CV output is on at a time: preset N turns on output N (output 8 stays off).
<http://srmourasilva.github.io/plugins/hept7-switch#preset-one-to-one-selector>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/hept7-switch> ;
    rdfs:label "One-to-one selector" ;
    lv2:port [ lv2:symbol "Preset_selector_1" ; pset:value 1.0 ] ,
             [ lv2:symbol "Preset_selector_2" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_selector_3" ; pset:value 0.0 ] ,
             [ lv2:symbol "Preset_selector_4" ; pset:value 0.0 ] ,
