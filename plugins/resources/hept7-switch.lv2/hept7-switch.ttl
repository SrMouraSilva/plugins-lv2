    lv2:name "Preset 7 - Dip switches" .

<http://srmourasilva.github.io/plugins/hept7-switch>
    a lv2:Plugin, mod:ControlVoltagePlugin, mod:UtilityPlugin ;

doap:name "Hept7 switch" ;
doap:license <http://opensource.org/licenses/Apache-2.0> ;
doap:developer [
    foaf:name "Paulo Mateus" ;
    foaf:homepage <> ;
    foaf:mbox <mailto:mateus.moura@hotmail.com> ;
    ];

doap:maintainer [
    foaf:name "SrMouraSilva" ;
    foaf:homepage <https://github.com/SrMouraSilva/plugins-lv2> ;
    foaf:mbox <mailto:mateus.moura@hotmail.com> ;
    ];

    lv2:requiredFeature urid:map, <http://kx.studio/ns/lv2ext/control-input-port-change-request>;
    lv2:optionalFeature lv2:hardRTCapable, state:loadDefaultState, <http://moddevices.com/ns/hmi#WidgetControl>, work:schedule;
    lv2:extensionData <http://moddevices.com/ns/hmi#PluginNotification>, state:interface, work:interface;

    lv2:majorVersion 1 ;
    lv2:minorVersion 0 ;
    lv2:microVersion 5 ;

rdfs:comment """
Hept7 switch is a loop switcher for CV, the big sibling of Tetr4 switch. Store which of its eight CV outputs are on in each of seven presets, and change between them with a footswitch. It comes with a full-screen, touch-friendly settings page and a small display that shows the preset on every device, even the ones without a screen for plugins.
""" ;

lv2:port
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 0;
    lv2:symbol "Cv_output_1";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 1";
    rdfs:comment "CV output 1. Its value is set by output 1 of the currently active preset's dip switches." ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 1;
    lv2:symbol "Cv_output_2";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 2";
    rdfs:comment "CV output 2. Its value is set by output 2 of the currently active preset's dip switches." ;
],
[
    a lv2:OutputPort, lv2:CVPort, mod:CVPort;
    lv2:index 2;
    lv2:symbol "Cv_output_3";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 3";
    rdfs:comment "CV output 3. Its value is set by output 3 of the currently active preset's dip switches." ;
],
[
