    lv2:index 4;
    lv2:symbol "Cv_output_5";
    pg:group plug:group_cv_outputs ;
    lv2:name "CV Output 5";
    rdfs:comment "CV output 5. Its value is set by output 5 of the currently active preset's dip switches." ;
],
