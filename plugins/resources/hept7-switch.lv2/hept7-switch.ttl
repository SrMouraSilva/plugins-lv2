@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix epp:  <http://lv2plug.in/ns/ext/port-props#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix work: <http://lv2plug.in/ns/ext/worker#> .
@prefix plug: <http://srmourasilva.github.io/plugins/hept7-switch#> .

# Port layout (keep in sync with plugins/src/model/ports.h):
#   0-7    CV outputs
#   8-14   Preset selectors (footswitch selectors)
#   15     Current preset
#   16-19  Assign to notify
#   20-75  Dip switches, preset by preset (preset 1 outputs 1-8, preset 2 outputs 1-8, ...)
#   76-77  Events in / out
#   78-84  In the cycle of "Current preset", preset by preset (added after the events: ports are never renumbered)
#   85     Active preset (output, for the interface)

plug:preset_label_1
    a lv2:Parameter ;
    rdfs:label "Preset label 1" ;
    rdfs:comment "Custom name shown for preset 1, instead of the default 'Preset 1'." ;
    rdfs:range atom:String .

plug:preset_label_2
    a lv2:Parameter ;
    rdfs:label "Preset label 2" ;
    rdfs:comment "Custom name shown for preset 2, instead of the default 'Preset 2'." ;
    rdfs:range atom:String .

plug:preset_label_3
    a lv2:Parameter ;
    rdfs:label "Preset label 3" ;
    rdfs:comment "Custom name shown for preset 3, instead of the default 'Preset 3'." ;
    rdfs:range atom:String .

plug:preset_label_4
    a lv2:Parameter ;
    rdfs:label "Preset label 4" ;
    rdfs:comment "Custom name shown for preset 4, instead of the default 'Preset 4'." ;
    rdfs:range atom:String .

plug:preset_label_5
    a lv2:Parameter ;
    rdfs:label "Preset label 5" ;
    rdfs:comment "Custom name shown for preset 5, instead of the default 'Preset 5'." ;
    rdfs:range atom:String .

plug:preset_label_6
    a lv2:Parameter ;
    rdfs:label "Preset label 6" ;
    rdfs:comment "Custom name shown for preset 6, instead of the default 'Preset 6'." ;
    rdfs:range atom:String .

plug:preset_label_7
    a lv2:Parameter ;
    rdfs:label "Preset label 7" ;
    rdfs:comment "Custom name shown for preset 7, instead of the default 'Preset 7'." ;
    rdfs:range atom:String .

plug:group_cv_outputs
    a pg:Group ;
    lv2:symbol "cv_outputs" ;
    lv2:name "CV outputs" .

plug:group_preset_selection
    a pg:Group ;
    lv2:symbol "preset_selection" ;
    lv2:name "Preset selection" .

plug:group_notifications
    a pg:Group ;
    lv2:symbol "notifications" ;
    lv2:name "Notifications" .

plug:group_preset_1
    a pg:Group ;
    lv2:symbol "preset_1" ;
    lv2:name "Preset 1 - Dip switches" .

plug:group_preset_2
    a pg:Group ;
    lv2:symbol "preset_2" ;
    lv2:name "Preset 2 - Dip switches" .

plug:group_preset_3
    a pg:Group ;
    lv2:symbol "preset_3" ;
    lv2:name "Preset 3 - Dip switches" .

plug:group_preset_4
    a pg:Group ;
