    rdfs:comment "Selects preset 5 as the active preset. Assign a footswitch to it to switch presets. Turning it on turns the other Preset selectors off." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 13;
    lv2:symbol "Preset_selector_6" ;
    pg:group plug:group_preset_selection ;
    lv2:name "Preset 6" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1 ;
    lv2:portProperty lv2:integer, lv2:toggled, mod:preferMomentaryOnByDefault;
    rdfs:comment "Selects preset 6 as the active preset. Assign a footswitch to it to switch presets. Turning it on turns the other Preset selectors off." ;
],
[
    a lv2:InputPort, lv2:ControlPort ;
    lv2:index 14;
    lv2:symbol "Preset_selector_7" ;
