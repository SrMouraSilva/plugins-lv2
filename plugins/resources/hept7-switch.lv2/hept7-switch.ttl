    rdfs:comment "Output: the active preset (0 is preset 1), whatever selected it. Used by the interface of the plugin." ;
] ;

patch:writable plug:preset_label_1 ,
               plug:preset_label_2 ,
               plug:preset_label_3 ,
               plug:preset_label_4 ,
               plug:preset_label_5 ,
               plug:preset_label_6 ,
               plug:preset_label_7 ;

state:state [
    plug:preset_label_1 "Preset 1" ;
    plug:preset_label_2 "Preset 2" ;
    plug:preset_label_3 "Preset 3" ;
    plug:preset_label_4 "Preset 4" ;
    plug:preset_label_5 "Preset 5" ;
    plug:preset_label_6 "Preset 6" ;
    plug:preset_label_7 "Preset 7" ;
]

.
