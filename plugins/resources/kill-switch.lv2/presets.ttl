@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Factory presets: every one sets the five controls. The bypass (lv2_enabled) is not part of a preset.
# The rhythms named after a guitarist or a song are an approximation, not a transcription.

<http://srmourasilva.github.io/plugins/kill-switch#preset-killing-in-the-name-solo-chop>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/kill-switch> ;
    rdfs:label "Killing in the Name - solo chop" ;
    lv2:port
        [ lv2:symbol "pattern" ; pset:value 6 ],
        [ lv2:symbol "bpm" ; pset:value 89 ],
        [ lv2:symbol "speed" ; pset:value 1 ],
        [ lv2:symbol "depth" ; pset:value 100 ],
        [ lv2:symbol "edge" ; pset:value 1.5 ] .

<http://srmourasilva.github.io/plugins/kill-switch#preset-bulls-on-parade-toggle-solo>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/kill-switch> ;
