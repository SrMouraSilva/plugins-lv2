@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://srmourasilva.github.io/plugins/kill-switch>
    a lv2:Plugin , lv2:GatePlugin ;
    lv2:binary <kill-switch.so> ;
    rdfs:seeAlso <kill-switch.ttl> ,
                 <modgui.ttl> ;
    lv2:optionalFeature lv2:hardRTCapable .

<http://srmourasilva.github.io/plugins/kill-switch#preset-killing-in-the-name-solo-chop>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/kill-switch> ;
    rdfs:label "Killing in the Name - solo chop" ;
    rdfs:seeAlso <presets.ttl> .

