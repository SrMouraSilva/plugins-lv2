@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Factory presets: every one sets the eight controls of the two families (mode, pattern, ending, tempo, speed, length, depth,
# edge). The bypass (lv2_enabled), the mono input and the custom pattern are not part of a preset.

<http://srmourasilva.github.io/plugins/half-mouco#preset-ping-pong-8ths>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
    rdfs:label "Ping-pong 8ths" ;
    lv2:port
        [ lv2:symbol "mode" ; pset:value 0 ],
        [ lv2:symbol "pattern" ; pset:value 0 ],
        [ lv2:symbol "ending" ; pset:value 0 ],
        [ lv2:symbol "bpm" ; pset:value 120 ],
        [ lv2:symbol "speed" ; pset:value 1 ],
        [ lv2:symbol "length" ; pset:value 8 ],
        [ lv2:symbol "depth" ; pset:value 100 ],
        [ lv2:symbol "edge" ; pset:value 1.5 ] .

<http://srmourasilva.github.io/plugins/half-mouco#preset-ping-pong-16ths>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
    rdfs:label "Ping-pong 16ths" ;
    lv2:port
        [ lv2:symbol "mode" ; pset:value 0 ],
        [ lv2:symbol "pattern" ; pset:value 1 ],
        [ lv2:symbol "ending" ; pset:value 0 ],
        [ lv2:symbol "bpm" ; pset:value 120 ],
        [ lv2:symbol "speed" ; pset:value 1 ],
        [ lv2:symbol "length" ; pset:value 8 ],
        [ lv2:symbol "depth" ; pset:value 100 ],
        [ lv2:symbol "edge" ; pset:value 1.5 ] .

<http://srmourasilva.github.io/plugins/half-mouco#preset-half-deaf-left>
