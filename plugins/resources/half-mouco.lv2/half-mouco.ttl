        lv2:name "Custom left step 3" ;
        pg:group plug:group_custom ;
        rdfs:comment "The level of step 3 of the left side of the custom pattern: cut, half or pass. Set it on the settings page: tap a step to go to the next level." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Cut" ; rdf:value 0 ] ,
