        lv2:index 16 ;
        lv2:symbol "custom_left_step_2" ;
        lv2:name "Custom left step 2" ;
        pg:group plug:group_custom ;
        rdfs:comment "The level of step 2 of the left side of the custom pattern: cut, half or pass. Set it on the settings page: tap a step to go to the next level." ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Cut" ; rdf:value 0 ] ,
                       [ rdfs:label "Half" ; rdf:value 1 ] ,
                       [ rdfs:label "Pass" ; rdf:value 2 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
