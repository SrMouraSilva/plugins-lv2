@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix pg:     <http://lv2plug.in/ns/ext/port-groups#> .
@prefix plug:   <http://srmourasilva.github.io/plugins/half-mouco#> .
@prefix ahw:  <https://github.com/sejerpz/alabs-hmi-widgets#> .

plug:group_mode
    a pg:Group ;
    lv2:symbol "mode" ;
    lv2:name "Mode" .

plug:group_patterns
    a pg:Group ;
    lv2:symbol "patterns" ;
    lv2:name "Patterns" .

plug:group_endings
    a pg:Group ;
    lv2:symbol "endings" ;
    lv2:name "Endings" .

plug:group_feel
    a pg:Group ;
    lv2:symbol "feel" ;
    lv2:name "Tempo and feel" .

plug:group_custom
    a pg:Group ;
    lv2:symbol "custom" ;
    lv2:name "Custom pattern" .

<http://srmourasilva.github.io/plugins/half-mouco>
    a lv2:Plugin, lv2:GatePlugin ;

    doap:name "Half Mouco" ;
    doap:license <http://opensource.org/licenses/Apache-2.0> ;
    doap:developer [
        foaf:name "Paulo Mateus" ;
        foaf:homepage <> ;
    ] ;
    doap:maintainer [
        foaf:name "SrMouraSilva" ;
        foaf:homepage <https://github.com/SrMouraSilva/plugins-lv2> ;
    ] ;

    lv2:optionalFeature lv2:hardRTCapable, ahw:WidgetDraw ;
    lv2:extensionData ahw:WidgetNotification ;

    # Widgets for the display of devices with the aLabs HMI widgets extension (MOD Dwarf and Duo X on the Starless images):
    # optional, a host without it never shows them. Keep the symbols in step with WIDGET_SYMBOLS in the source.
    ahw:widget
    [
        a ahw:Widget ;
        lv2:symbol "stereo" ;
        lv2:name "Stereo pattern" ;
        rdfs:comment "The left and the right side: a row of steps for each, with the step that is playing, or the curve of the ending along its time. Placing it offers to assign Mode, Pattern and Tempo to controls of the device." ;
        ahw:minWidth 40 ;
        ahw:minHeight 14 ;
        ahw:naturalWidth 82 ;
        ahw:naturalHeight 37 ;
        ahw:pixelFormat ahw:Mono1 ;
        ahw:suggestedPorts ( "mode" "pattern" "bpm" ) ;
    ] ;

    # Raise the micro version whenever the modgui changes (MOD UI caches it for a year, keyed by this version)
    lv2:majorVersion 1 ;
    lv2:minorVersion 0 ;
    lv2:microVersion 11 ;

    rdfs:comment """
Half Mouco is the stereo sibling of Kill Switch: a rhythmic signal-cut effect in which the left and the right side have a row of steps each, so the sound changes with the side (a ping-pong, one ear chopped while the other is not). Besides the looping patterns (nine to choose from, and one you write yourself, with three levels per step) it has endings: effects for the end of a song, such as a bouncing ball or a helicopter that lands, that play once and finish in silence.
""" ;

    lv2:port
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In L"
    ],
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In R"
    ],
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L"
    ],
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R"
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        pg:group plug:group_mode ;
        rdfs:comment "Patterns loop for as long as the plugin is on. Endings play once when the plugin is switched on and finish in silence: effects for the end of a song. Assign it to a footswitch to jump from one to the other." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Patterns" ; rdf:value 0 ] ,
                       [ rdfs:label "Endings" ; rdf:value 1 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "pattern" ;
        lv2:name "Pattern" ;
        pg:group plug:group_patterns ;
        rdfs:comment "The rhythm of the cuts, with a row for each side. Every pattern starts with its first step each time the plugin is switched on. Custom plays the pattern you write on the settings page. Used in the Patterns mode." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 9 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Ping-pong 8ths" ; rdf:value 0 ] ,
                       [ rdfs:label "Ping-pong 16ths" ; rdf:value 1 ] ,
                       [ rdfs:label "Triplet pong" ; rdf:value 2 ] ,
                       [ rdfs:label "Half deaf: left" ; rdf:value 3 ] ,
                       [ rdfs:label "Half deaf: right" ; rdf:value 4 ] ,
                       [ rdfs:label "Gallop sides" ; rdf:value 5 ] ,
                       [ rdfs:label "Stagger" ; rdf:value 6 ] ,
                       [ rdfs:label "Seesaw" ; rdf:value 7 ] ,
                       [ rdfs:label "Syncopated sides" ; rdf:value 8 ] ,
                       [ rdfs:label "Custom" ; rdf:value 9 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "ending" ;
        lv2:name "Ending" ;
        pg:group plug:group_endings ;
        rdfs:comment "The effect for the end of a song, played once when the plugin is switched on. Used in the Endings mode." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Bouncing ball" ; rdf:value 0 ] ,
                       [ rdfs:label "Helicopter" ; rdf:value 1 ] ,
                       [ rdfs:label "Stutter out" ; rdf:value 2 ] ,
                       [ rdfs:label "Side fade" ; rdf:value 3 ] ,
                       [ rdfs:label "Ping-pong out" ; rdf:value 4 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "bpm" ;
        lv2:name "Tempo" ;
        pg:group plug:group_feel ;
        rdfs:comment "How fast it plays, in beats per minute. Set it by hand or assign it to a knob or an expression pedal." ;
        lv2:default 120 ;
        lv2:minimum 40 ;
        lv2:maximum 240 ;
        lv2:portProperty lv2:integer ;
        units:unit [
            a units:Unit ;
            rdfs:label "BPM" ;
            units:symbol "BPM" ;
            units:render "%d BPM"
        ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "speed" ;
        lv2:name "Speed" ;
        pg:group plug:group_patterns ;
        rdfs:comment "Plays the pattern at half, normal, double or four times its speed, without changing the tempo. Used in the Patterns mode." ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/2x" ; rdf:value 0 ] ,
                       [ rdfs:label "1x" ; rdf:value 1 ] ,
                       [ rdfs:label "2x" ; rdf:value 2 ] ,
                       [ rdfs:label "4x" ; rdf:value 3 ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "length" ;
        lv2:name "Length" ;
        pg:group plug:group_endings ;
        rdfs:comment "How long an ending lasts, in beats at the tempo: at 120 BPM, 8 beats are 4 seconds. Used in the Endings mode." ;
        lv2:default 8 ;
        lv2:minimum 2 ;
        lv2:maximum 32 ;
        lv2:portProperty lv2:integer ;
        units:unit [
            a units:Unit ;
            rdfs:label "beats" ;
            units:symbol "beats" ;
            units:render "%d beats"
        ]
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "depth" ;
        lv2:name "Depth" ;
        pg:group plug:group_feel ;
        rdfs:comment "How much of the signal a cut removes: 100% is silence, lower values only dip the level." ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        units:unit units:pc
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "edge" ;
        lv2:name "Edge" ;
        pg:group plug:group_feel ;
        rdfs:comment "How long each cut takes to open and close. Short is a hard, percussive chop; long is a soft swell." ;
        lv2:default 1.5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 20 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "mono" ;
        lv2:name "Mono input" ;
        pg:group plug:group_mode ;
        rdfs:comment "On: the left input feeds both sides, for a single instrument. Off: each side keeps its own input." ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "custom_length" ;
        lv2:name "Custom length" ;
        pg:group plug:group_custom ;
        rdfs:comment "How many steps the custom pattern has, from 1 to 16. Only the first steps are played." ;
        lv2:default 8 ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "custom_steps_per_beat" ;
        lv2:name "Custom steps per beat" ;
        pg:group plug:group_custom ;
        rdfs:comment "How many steps of the custom pattern make a beat, from 1 to 8: 2 is eighth notes, 4 is sixteenths, 3 is triplets." ;
        lv2:default 2 ;
        lv2:minimum 1 ;
        lv2:maximum 8 ;
        lv2:portProperty lv2:integer
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "custom_left_step_1" ;
        lv2:name "Custom left step 1" ;
        pg:group plug:group_custom ;
        rdfs:comment "The level of step 1 of the left side of the custom pattern: cut, half or pass. Set it on the settings page: tap a step to go to the next level." ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Cut" ; rdf:value 0 ] ,
                       [ rdfs:label "Half" ; rdf:value 1 ] ,
                       [ rdfs:label "Pass" ; rdf:value 2 ]
    ],
    [
