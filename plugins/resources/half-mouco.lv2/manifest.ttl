    rdfs:seeAlso <presets.ttl> .

<http://srmourasilva.github.io/plugins/half-mouco#preset-stagger>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
    rdfs:label "Stagger" ;
    rdfs:seeAlso <presets.ttl> .

<http://srmourasilva.github.io/plugins/half-mouco#preset-bouncing-ball>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
