@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://srmourasilva.github.io/plugins/half-mouco>
    a lv2:Plugin , lv2:GatePlugin ;
    lv2:binary <half-mouco.so> ;
    rdfs:seeAlso <half-mouco.ttl> ,
                 <modgui.ttl> ;
    lv2:optionalFeature lv2:hardRTCapable .

<http://srmourasilva.github.io/plugins/half-mouco#preset-ping-pong-8ths>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
    rdfs:label "Ping-pong 8ths" ;
    rdfs:seeAlso <presets.ttl> .

<http://srmourasilva.github.io/plugins/half-mouco#preset-ping-pong-16ths>
    a pset:Preset ;
    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
    rdfs:label "Ping-pong 16ths" ;
    rdfs:seeAlso <presets.ttl> .

