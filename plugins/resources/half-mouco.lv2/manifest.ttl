    lv2:appliesTo <http://srmourasilva.github.io/plugins/half-mouco> ;
    rdfs:label "Half deaf: left" ;
    rdfs:seeAlso <presets.ttl> .

<http://srmourasilva.github.io/plugins/half-mouco#preset-half-deaf-right>
